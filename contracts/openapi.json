{
  "openapi": "3.1.0",
  "info": {
    "title": "César Core",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Read Health",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Read Readiness",
        "operationId": "read_readiness_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "Read Capabilities",
        "operationId": "read_capabilities_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ai/generate": {
      "post": {
        "tags": [
          "ai"
        ],
        "summary": "Generate Ai",
        "operationId": "generate_ai_v1_ai_generate_post",
        "security": [
          {
            "ApplicationBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Service",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Service"
            }
          },
          {
            "name": "X-Purpose",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Purpose"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIRequestPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Search Web",
        "operationId": "search_web_v1_search_post",
        "security": [
          {
            "ApplicationBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Service",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Service"
            }
          },
          {
            "name": "X-Purpose",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Purpose"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequestPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "title": "Code"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "title": "Request Id"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Correlation Id"
          },
          "upstream_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upstream Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id",
          "correlation_id"
        ],
        "title": "AIErrorDetail",
        "description": "Detalhe de erro estável do endpoint AI."
      },
      "AIErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/AIErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "AIErrorResponse",
        "description": "Envelope público de erro do Central AI Gateway."
      },
      "AIMessage": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/AIMessageRole"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "AIMessage",
        "description": "Mensagem textual de domínio; independente do envelope HTTP."
      },
      "AIMessageRole": {
        "type": "string",
        "enum": [
          "system",
          "user",
          "assistant"
        ],
        "title": "AIMessageRole"
      },
      "AIRequestPayload": {
        "oneOf": [
          {
            "required": [
              "prompt"
            ]
          },
          {
            "required": [
              "messages"
            ]
          }
        ],
        "properties": {
          "requirements": {
            "$ref": "#/components/schemas/Requirements"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt"
          },
          "messages": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/AIMessage"
                },
                "type": "array",
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Messages"
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens",
            "description": "Hard completion-token ceiling. César Core rejects a response when the upstream usage proves that this ceiling was exceeded."
          }
        },
        "type": "object",
        "required": [
          "requirements"
        ],
        "title": "AIRequestPayload",
        "description": "DTO HTTP público de uma requisição de AI.\n\nNão recebe ``application_id`` nem qualquer outro dado de identidade\nno corpo: quem está chamando é sempre resolvido pelo Core, nunca\ndeclarado pelo cliente dentro do payload."
      },
      "AIResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "title": "Request Id"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Correlation Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "provider_gateway": {
            "type": "string",
            "minLength": 1,
            "title": "Provider Gateway"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "title": "Model"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AIUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Latency Ms"
          },
          "fallback_used": {
            "type": "boolean",
            "title": "Fallback Used",
            "default": false
          },
          "upstream_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upstream Request Id"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "correlation_id",
          "content",
          "provider_gateway",
          "model",
          "latency_ms"
        ],
        "title": "AIResponse",
        "description": "Resposta neutra de AI devolvida pelo César Core."
      },
      "AIUsage": {
        "properties": {
          "prompt_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Tokens"
          },
          "completion_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Completion Tokens"
          },
          "total_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Tokens"
          }
        },
        "type": "object",
        "title": "AIUsage",
        "description": "Uso de tokens normalizado, quando informado pelo upstream."
      },
      "CapabilitiesResponse": {
        "properties": {
          "core": {
            "$ref": "#/components/schemas/ServiceStatus",
            "default": "available"
          },
          "application_registry": {
            "$ref": "#/components/schemas/ServiceStatus",
            "default": "available"
          },
          "application_authentication": {
            "$ref": "#/components/schemas/ServiceStatus",
            "default": "not_configured"
          },
          "metrics": {
            "$ref": "#/components/schemas/ServiceStatus",
            "default": "available"
          },
          "ai": {
            "$ref": "#/components/schemas/ServiceStatus",
            "default": "not_configured"
          },
          "search": {
            "$ref": "#/components/schemas/ServiceStatus",
            "description": "Aggregated Search availability for at least one purpose.",
            "default": "not_configured"
          },
          "search_general_web": {
            "$ref": "#/components/schemas/ServiceStatus",
            "description": "General Web Search target availability.",
            "default": "not_configured"
          },
          "search_technical_documentation": {
            "$ref": "#/components/schemas/ServiceStatus",
            "description": "Technical-documentation Search target availability.",
            "default": "not_configured"
          },
          "omniroute": {
            "$ref": "#/components/schemas/ServiceStatus",
            "default": "not_configured"
          }
        },
        "type": "object",
        "title": "CapabilitiesResponse",
        "description": "Resposta de GET /v1/capabilities.\n\nSemântica exata (ver ADR 0008): informa quais capacidades existem e\nseu estado -- é um inventário, não um gate de prontidão. O transporte\nOmniRoute fica ``available`` quando ao menos um gateway de domínio está\nconfigurado. AI e Search são reportados independentemente; Search também\nexplicita a cobertura semântica geral e de documentação técnica."
      },
      "CostPolicy": {
        "type": "string",
        "enum": [
          "free_only",
          "free_preferred",
          "paid_allowed"
        ],
        "title": "CostPolicy",
        "description": "Restrição de custo que a aplicação consumidora aceita para a chamada."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthStatus",
        "description": "Resposta de GET /health: só confirma que o processo está vivo.\n\nNão checa nenhuma dependência, capacidade ou dado -- isso é papel de\n/ready. Ver ADR 0008 para a semântica exata dos três endpoints."
      },
      "ReadinessStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "core": {
            "$ref": "#/components/schemas/ServiceStatus",
            "default": "available"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "quota_store_misconfigured",
                  "quota_store_unavailable"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Safe quota dependency failure reason; omitted when absent."
          }
        },
        "type": "object",
        "title": "ReadinessStatus",
        "description": "Resposta de GET /ready.\n\nSemântica exata (ver ADR 0008): /ready responde se o César Core está\napto a atender as capacidades ATUALMENTE configuradas/habilitadas --\nnão todas as capacidades que um dia poderão existir. Uma capacidade\nNOT_CONFIGURED nunca bloqueia readiness, porque ela ainda não foi\nhabilitada e portanto não impõe dependência obrigatória nenhuma.\nQuando uma capacidade for habilitada, readiness\npassa a refletir só as dependências obrigatórias dela -- nunca \"ok\"\nfingido para uma dependência habilitada e quebrada."
      },
      "Requirements": {
        "properties": {
          "service_class": {
            "$ref": "#/components/schemas/ServiceClass"
          },
          "cost_policy": {
            "$ref": "#/components/schemas/CostPolicy"
          }
        },
        "type": "object",
        "required": [
          "service_class",
          "cost_policy"
        ],
        "title": "Requirements",
        "description": "O que uma execução exige em termos de qualidade/custo.\n\nResponsabilidade final (ver ADR 0009): ``ApplicationContext`` é\nquem está chamando + por quê + identidade/tracing da chamada;\n``Requirements`` é quais capacidades/qualidade/custo a execução\nexige. Por isso não há campo ``service`` aqui -- ele já existe em\n``ApplicationContext`` (o serviço/processo chamador) e um segundo\ncampo de mesmo nome, com significado diferente (qual gateway:\nai/search), era exatamente a duplicação que a TASK-118A pediu para\nremover. Qual gateway (AI vs Search) já é dado pelo tipo do request\n(``AIRequest`` vs ``SearchRequest``), não precisa ser repetido aqui.\n\n``structured_output``, ``reasoning``, ``vision``, ``tool_calling``\n(capacidades específicas) não foram adicionados nesta correção:\nficam para quando uma TASK futura precisar deles de fato."
      },
      "SearchErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "title": "Code"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "title": "Request Id"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Correlation Id"
          },
          "upstream_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upstream Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id",
          "correlation_id"
        ],
        "title": "SearchErrorDetail",
        "description": "Detalhe de erro estável do endpoint Search."
      },
      "SearchErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/SearchErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "SearchErrorResponse",
        "description": "Envelope público de erro do Central Web Search Gateway."
      },
      "SearchRequestPayload": {
        "properties": {
          "requirements": {
            "$ref": "#/components/schemas/Requirements"
          },
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          },
          "max_results": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Results",
            "description": "Limite obrigatório dos resultados expostos. Encaminhado ao upstream; não garante limite de aquisição externa quando o provider não o suporta.",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "requirements",
          "query"
        ],
        "title": "SearchRequestPayload",
        "description": "DTO HTTP público de uma requisição de busca.\n\nNão recebe ``application_id`` nem qualquer outro dado de identidade\nno corpo: quem está chamando é sempre resolvido pelo Core, nunca\ndeclarado pelo cliente dentro do payload."
      },
      "SearchResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "title": "Request Id"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Correlation Id"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "provider_gateway": {
            "type": "string",
            "minLength": 1,
            "title": "Provider Gateway"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "title": "Provider"
          },
          "usage": {
            "$ref": "#/components/schemas/SearchUsage"
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Latency Ms"
          },
          "total_results_available": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Results Available"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          },
          "fallback_used": {
            "type": "boolean",
            "title": "Fallback Used",
            "default": false
          },
          "upstream_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upstream Request Id"
          },
          "upstream_issues": {
            "items": {
              "$ref": "#/components/schemas/SearchUpstreamIssue"
            },
            "type": "array",
            "title": "Upstream Issues"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "correlation_id",
          "provider_gateway",
          "provider",
          "usage",
          "latency_ms"
        ],
        "title": "SearchResponse",
        "description": "Forma neutra de uma resposta de busca devolvida pelo César Core."
      },
      "SearchResult": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "default": ""
          },
          "position": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          }
        },
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "SearchResult",
        "description": "Um resultado individual de busca."
      },
      "SearchUpstreamIssue": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "code",
          "message"
        ],
        "title": "SearchUpstreamIssue",
        "description": "Falha parcial reportada pelo upstream sem invalidar a resposta."
      },
      "SearchUsage": {
        "properties": {
          "queries_used": {
            "type": "integer",
