# Configuração de processo do César Core (sem segredos).

CESAR_CORE_APP_ENV=development
CESAR_CORE_HOST=127.0.0.1
CESAR_CORE_PORT=8100
CESAR_CORE_LOG_LEVEL=info

# Transporte de baixo nível para o OmniRoute. AI e Search usam credenciais
# independentes e sem escopo manage (mínimo privilégio). Os segredos nunca
# vão no .env: cada *_FILE aponta para um arquivo local fora do Git.
CESAR_CORE_OMNIROUTE_BASE_URL=http://127.0.0.1:20128
CESAR_CORE_OMNIROUTE_TIMEOUT_SECONDS=30
CESAR_CORE_OMNIROUTE_AI_API_KEY_FILE=.secrets/ggoferta-ai
CESAR_CORE_OMNIROUTE_SEARCH_API_KEY_FILE=.secrets/ggoferta-search

# Autenticação aplicação -> César Core (TASK-118E). Somente GG Oferta está
# ACTIVE e possui credencial funcional. Não criar arquivo/chave do Claudião.
CESAR_CORE_SECURITY_GG_OFERTA_API_KEY_FILE=.secrets/ggoferta-core-client
CESAR_CORE_SECURITY_AI_REQUESTS_PER_MINUTE=60
CESAR_CORE_SECURITY_SEARCH_REQUESTS_PER_MINUTE=60

# Central AI Gateway (TASK-118C). Permanece desligado até existir ao menos
# um modelo configurado no OmniRoute. Os overrides por classe são opcionais;
# quando ausentes, usam DEFAULT_MODEL.
CESAR_CORE_AI_ENABLED=false
CESAR_CORE_AI_DEFAULT_MODEL=
CESAR_CORE_AI_ECONOMY_MODEL=
CESAR_CORE_AI_STANDARD_MODEL=
CESAR_CORE_AI_QUALITY_MODEL=
CESAR_CORE_AI_PROVIDER=
CESAR_CORE_AI_MODEL_IS_PAID=false
# Opt-in somente para um modelo/provider fixo validado em contract test real.
# Aliases dinâmicos como auto/best-free não podem declarar esta garantia.
CESAR_CORE_AI_MODEL_ENFORCES_MAX_TOKENS=false
CESAR_CORE_AI_MAX_TOKENS_LIMIT=4096

# Central Web Search Gateway (TASK-118D). Permanece desligado até ENABLED=true.
# Busca geral só fica configurada quando DEFAULT_PROVIDER ou um override por
# classe possui alvo. Context7 fica restrito ao purpose technical_documentation.
# Provider é escolhido pela policy interna e nunca pelo body público.
CESAR_CORE_SEARCH_ENABLED=false
CESAR_CORE_SEARCH_DEFAULT_PROVIDER=
# 118G: para SearXNG local certificado, configurar explicitamente ambos:
# CESAR_CORE_SEARCH_DEFAULT_PROVIDER=searxng-search
# CESAR_CORE_SEARCH_PROVIDER_HEALTH_URL=http://127.0.0.1:18888/healthz
CESAR_CORE_SEARCH_PROVIDER_HEALTH_URL=
CESAR_CORE_SEARCH_ECONOMY_PROVIDER=
CESAR_CORE_SEARCH_STANDARD_PROVIDER=
CESAR_CORE_SEARCH_QUALITY_PROVIDER=
CESAR_CORE_SEARCH_TECHNICAL_DOCUMENTATION_PROVIDER=context7
CESAR_CORE_SEARCH_PROVIDER_IS_PAID=false
CESAR_CORE_SEARCH_MAX_RESULTS_LIMIT=20
